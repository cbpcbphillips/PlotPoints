# Keep the build context small and free of secrets. The checkpoints in particular are
# bind-mounted at runtime; baking a multi-GB data/ directory into an image layer would be
# slow and pointless.
.git
.env
.venv
.idea
.ruff_cache
__pycache__/
*.pyc
data/
logs/
airflow.db
airflow.cfg
.astro/standalone/
plotpoints_dbt/logs/
plotpoints_dbt/target/
plotpoints_dbt/dbt_packages/
