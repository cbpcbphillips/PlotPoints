# ============================================================
# PlotPoints — environment configuration template
# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.
# ============================================================

# --- TMDB ---
# TMDB API key (v3 auth) — https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMBD_READ_TOKEN=

# --- Snowflake ---
# Account identifier, e.g. abc12345.us-east-1
# Find it in Snowsight: username (bottom-left) -> Account, or from the
# browser URL: https://<account_identifier>.snowflakecomputing.com
SNOWFLAKE_ACCOUNT=

# Service account used by scripts/dbt — not a personal login
SNOWFLAKE_USER=PLOTPOINTS_SVC
SNOWFLAKE_ROLE=PLOTPOINTS_ROLE
SNOWFLAKE_WAREHOUSE=PLOTPOINTS_WH
SNOWFLAKE_DATABASE=PLOTPOINTS_DB
SNOWFLAKE_SCHEMA='PUBLIC'

# Absolute path to the RSA private key file used for key-pair auth.
# Keep this file OUTSIDE the repo — do not point this at a path inside
# the project folder.
SNOWFLAKE_PRIVATE_KEY_PATH=

# Leave blank if the private key was generated without a passphrase
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Name of the Snowflake storage integration object (used when creating
# the external stage against S3)
SNOWFLAKE_STORAGE_INTEGRATION=plotpoints_s3_int

# --- AWS S3 (write-only uploader credentials) ---
# These belong to a narrowly-scoped IAM user (e.g. "plotpoints-uploader")
# with PutObject/ListBucket permissions on the bucket below ONLY.
# Snowflake itself reads from S3 via a separate IAM role bound to the
# storage integration above — that role's ARN is never stored here.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=